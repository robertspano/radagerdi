    "drykkir.html": {
      "DIV1>DIV2>DIV0>DIV0": "\n          <h2><span>Húsvín</span></h2>\n          <p class=\"vnote\">Glas / flaska</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 27px !important;\">Rauðvín / Hvítvín / Rósavín / Freyðivín</span><span class=\"ti-pr\"><b class=\"ti-new\">1.700 / 7.500 kr</b></span></div></div>\n        ",
      "DIV1>DIV2>DIV0>DIV1": "\n          <h2><span class=\"\">Rauðvín</span></h2>\n          <p class=\"vnote\">Vínflöskur — glas / flaska þar sem við á</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Puszta Libre</span><span class=\"ti-pr\"><b class=\"ti-new\">2.200 / 10.400 kr</b></span></div>\n            <p class=\"ti-desc\">Claus Preisinger · Austurríki</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Ramon Bilbao Crianza</span><span class=\"ti-pr\"><b class=\"ti-new\">8.900 kr</b></span></div>\n            <p class=\"ti-desc\">Rioja · Spánn</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Grotta Rossa</span><span class=\"ti-pr\"><b class=\"ti-new\">9.900 kr</b></span></div>\n            <p class=\"ti-desc\">Sardinia · Ítalía</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Laurent Miquel Solas</span><span class=\"ti-pr\"><b class=\"ti-new\">9.900 kr</b></span></div>\n            <p class=\"ti-desc\">Languedoc Pinot Noir · Frakkland</p></div>\n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Nizza DOCG</span><span class=\"ti-pr\"><b class=\"ti-new\">12.900 kr</b></span></div>\n            <p class=\"ti-desc\">Piedmonte · Ítalía</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Glen Carlou Grand Cassique</span><span class=\"ti-pr\"><b class=\"ti-new\">13.900 kr</b></span></div>\n            <p class=\"ti-desc\">Bordeaux Blend · Suður-Afríka</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Nespoli Borgo dei Guidi</span><span class=\"ti-pr\"><b class=\"ti-new\">14.900 kr</b></span></div>\n            <p class=\"ti-desc\">Emilia Romagna · Ítalía</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Enzo Bartoli Barolo DOCG</span><span class=\"ti-pr\"><b class=\"ti-new\">18.900 kr</b></span></div>\n            <p class=\"ti-desc\">Piedmonte · Ítalía</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Cruz de Alba Crianza</span><span class=\"ti-pr\"><b class=\"ti-new\">19.900 kr</b></span></div>\n            <p class=\"ti-desc\">Ribera del Duero · Spánn</p></div>\n        ",
      "DIV1>DIV2>DIV0>DIV2": "\n          <h2 class=\"\"><span>Hvítvín</span></h2>\n          <p class=\"vnote\">Flaska</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 25px !important;\">Von Winning</span><span class=\"ti-pr\"><b class=\"ti-new\">10.900 kr</b></span></div>\n            <p class=\"ti-desc\">Riesling · Þýskaland</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 25px !important;\">Domain Laroche St. Martin</span><span class=\"ti-pr\"><b class=\"ti-new\">13.900 kr</b></span></div>\n            <p class=\"ti-desc\">Chablis · Frakkland</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Tenuta Meraviglia Vermentino</span><span class=\"ti-pr\"><b class=\"ti-new\">13.900 kr</b></span></div>\n            <p class=\"ti-desc\">Bolgheri · Toscana</p></div>\n        ",
      "DIV1>DIV2>DIV0>DIV3": "\n          <h2><span class=\"\" style=\"font-size: 47px !important;\">Freyðivín &amp; Rósavín</span></h2>\n          <p class=\"vnote\">Glas / flaska</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Moillard Prestige Brut</span><span class=\"ti-pr\"><b class=\"ti-new\">2.400 / 11.900 kr</b></span></div>\n            <p class=\"ti-desc\">Cremant · Frakkland</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Rosza Libre</span><span class=\"ti-pr\"><b class=\"ti-new\">2.200 / 10.400 kr</b></span></div>\n            <p class=\"ti-desc\">Rósavín · Claus Preisinger · Austurríki</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Veuve Clicquot</span><span class=\"ti-pr\"><b class=\"ti-new\">26.900 kr</b></span></div>\n            <p class=\"ti-desc\">Champagne · Frakkland</p></div>\n          \n        ",
      "DIV1>DIV2>DIV0>DIV5": "\n          <h2 class=\"\"><span class=\"\">Bjór</span></h2>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Á krana · 0,4 l</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Gull Lite</span><span class=\"ti-pr\"><b class=\"ti-new\">1.650 kr</b></span></div>\n            <p class=\"ti-desc\">Lager</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Boli</span><span class=\"ti-pr\"><b class=\"ti-new\">1.750 kr</b></span></div>\n            <p class=\"ti-desc\">Lager</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Tuborg Classic</span><span class=\"ti-pr\"><b class=\"ti-new\">1.750 kr</b></span></div>\n            <p class=\"ti-desc\">Amber lager</p></div>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Flöskubjór</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Gull</span><span class=\"ti-pr\"><b class=\"ti-new\">1.650 kr</b></span></div>\n            <p class=\"ti-desc\">Lager</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Peroni</span><span class=\"ti-pr\"><b class=\"ti-new\">1.650 kr</b></span></div>\n            <p class=\"ti-desc\">Lager</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Úlfur</span><span class=\"ti-pr\"><b class=\"ti-new\">1.800 kr</b></span></div>\n            <p class=\"ti-desc\">IPA</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Sommersby</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div>\n            <p class=\"ti-desc\">Cider</p></div>\n        ",
      "DIV1>DIV2>DIV1>DIV3": "\n          <h2><span class=\"\">Digestivo / Bar</span></h2>\n          <p class=\"vnote\">Spyrjið þjóninn um frekara úrval af sterku víni</p>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Gin</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Himbrimi</span><span class=\"ti-pr\"><b class=\"ti-new\">1.700 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Tanqueray</span><span class=\"ti-pr\"><b class=\"ti-new\">1.600 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Bombay Sapphire</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div></div>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Viskí</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Jameson</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div>\n            <p class=\"ti-desc\">Írskt</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Aberfeldy</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div>\n            <p class=\"ti-desc\">12 ára · Skoskt</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Four Roses</span><span class=\"ti-pr\"><b class=\"ti-new\">1.600 kr</b></span></div>\n            <p class=\"ti-desc\">Bourbon</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Bulleit</span><span class=\"ti-pr\"><b class=\"ti-new\">1.600 kr</b></span></div>\n            <p class=\"ti-desc\">Bourbon</p></div>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Grappa</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Berta Nizza</span><span class=\"ti-pr\"><b class=\"ti-new\">2.000 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Berta L’Angelo</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Berta Nibbio</span><span class=\"ti-pr\"><b class=\"ti-new\">1.200 kr</b></span></div></div>\n          <p class=\"sub\" style=\"color: rgb(255, 255, 255) !important;\">Digestivo</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Limoncello</span><span class=\"ti-pr\"><b class=\"ti-new\">1.300 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Bailey’s</span><span class=\"ti-pr\"><b class=\"ti-new\">1.200 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Grand Marnier</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Koníak VSOP</span><span class=\"ti-pr\"><b class=\"ti-new\">1.500 kr</b></span></div></div>\n        ",
      "DIV2>DIV0": "<img src=\"assets/insta/insta-01.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-02.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-03.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-04.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-05.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-06.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-07.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-08.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-09.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-01.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-02.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-03.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-04.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-05.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-06.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-07.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-08.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-09.jpg\" alt=\"\" loading=\"lazy\">"
    },
    "matsedlar.html": {
      "DIV1>DIV3>DIV2": "\n          <h2><span>Focaccia</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Eldbakað hvítlauks-Focaccia</span><span class=\"ti-pr\"><b class=\"ti-new\">2790 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Focaccia samloka</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Eldbökuð focaccia samloka með klettasalati, burrata stracciatella, pistasíu pestói, tómötum, rauðlauk og blönduðum ólífum. Veldu álegg: parmaskinka, mortadella, reyktur lax eða grillaður kúrbítur. Hálf: 2490 KR.</p></div>\n        ",
      "DIV1>DIV3>DIV3": "\n          <h2><span class=\"\">Smáréttir</span></h2>\n          <p class=\"vnote\">Tilvalið til að deila</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Heitar <br>ólífur (V)</span><span class=\"ti-pr\"><b class=\"ti-new\">1590 kr</b></span></div>\n            <p class=\"ti-desc\">Eldbakaðar ólífur í olíu, kryddaðar með oregano, rósmarín og chili flögum, bornar fram með brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Gullauga smælki</span><span class=\"ti-pr\"><b class=\"ti-new\">1690 kr</b></span></div>\n            <p class=\"ti-desc\">Borið fram með trufflu aioli, parmesan og trufflu salti</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Beikonvafðar Döðlur</span><span class=\"ti-pr\"><b class=\"ti-new\">2190 kr</b></span></div>\n            <p class=\"ti-desc\">Bornar fram með heimagerðri gráðostasósu</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Hvítlauks Rækjur</span><span class=\"ti-pr\"><b class=\"ti-new\">2990 kr</b></span></div>\n            <p class=\"ti-desc\">Chili og hvítlauks marineraðar rækjur toppaðar með gremolata og bornar fram með mjúku eldbökuðu brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Arancini <br>(2 stk)</span><span class=\"ti-pr\"><b class=\"ti-new\">1790 kr</b></span></div>\n            <p class=\"ti-desc\">Stökkar sveppa risotto kúlur fylltar með mozzarella osti bornar fram með heimagerðri marinarasósu, steiktum kastaníusveppum, toppað með gremolata og parmesan osti. 2 stk 1790 / 4 stk 2990</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Arancini <br>(4 stk)</span><span class=\"ti-pr\"><b class=\"ti-new\">2990 kr</b></span></div>\n            <p class=\"ti-desc\">Stökkar sveppa risotto kúlur fylltar með mozzarella osti bornar fram með heimagerðri marinarasósu, steiktum kastaníusveppum, toppað með gremolata og parmesan osti</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Grillað Romain Salat</span><span class=\"ti-pr\"><b class=\"ti-new\">2690 kr</b></span></div>\n            <p class=\"ti-desc\">Með gráðosti, karmelíseruðum valhnetum, þurrkuðum trönuberjum og sítrónudressingu.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Burrata</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Ítalskur burrata ostur, tómatar, pistasíu pestó dressing og muldar pistasíur. Borið fram með stökku eldbökuðu brauði.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Djúpsteiktur Burrata</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Ítalskur burrata ostur með rjómalagaðri marinara sósu, pistasíu pestói, chili crisp og muldum pistasíum. Borið fram með stökku eldbökuðu brauði.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Nauta carpaccio</span><span class=\"ti-pr\"><b class=\"ti-new\">3490 kr</b></span></div>\n            <p class=\"ti-desc\">Þunnt skorin nautalund með trufflu aioli, jarðskokka flögum, parmesan osti, klettasalati og trufflu salti.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Nautarif</span><span class=\"ti-pr\"><b class=\"ti-new\">3390 kr</b></span></div>\n            <p class=\"ti-desc\">Hægeldað nautarif í hunangs pipar marineringu. Toppað með gremolata.</p></div>\n          \n          \n          \n          \n          \n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Beinmergur</span><span class=\"ti-pr\"><b class=\"ti-new\">2890 kr</b></span></div>\n            <p class=\"ti-desc\">Nautabeinmergur toppað með brúnuðu sítrónusmjöri og kapers. Borið fram með stökku hvítlauksbrauði.</p></div>\n          \n          \n          \n          \n          \n          \n        <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Eldakaður Gullostur</span><span class=\"ti-pr\"><b class=\"ti-new\">2990 kr</b></span></div>\n            <p class=\"ti-desc\">Með chili hunangi, karamelluseruðum valhnetum og jarðaberjum. Borið fram með stökku eldbökuðu brauði</p></div>",
      "DIV1>DIV3>DIV4": "\n          <h2><span>Pizza</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Margherita</span><span class=\"ti-pr\"><b class=\"ti-new\">2890 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, ferskur mozzarella og fersk basilika</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Pepperóní &amp; ólífur</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, ostur, pepperóni, blandaðar ólífur og gremolata</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Pepperóní &amp; chili</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, ostur, pepperóni, ferskur chili, döðlur, mascarpone, toppað með chili hunangi</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Pepperóní &amp; Nduja</span><span class=\"ti-pr\"><b class=\"ti-new\">3890 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, ostur, pepperoni, nduja og gráðaostur.</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Parma &amp; klettasalat</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, mozzarella, parmaskinka, klettasalat og parmesan</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Rækjur &amp; Þistilhjörtu</span><span class=\"ti-pr\"><b class=\"ti-new\">3990 kr</b></span></div>\n            <p class=\"ti-desc\">Mascarpone, ostur, chili marineraðar tígrisrækjur, þistilhjörtu, gremolata og parmesan.</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Burrata stracciatella</span><span class=\"ti-pr\"><b class=\"ti-new\">3690 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, hálfþurrkaðir tómatar, burrata stracciatella og jurtaolía</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Truffla &amp; kartöflur</span><span class=\"ti-pr\"><b class=\"ti-new\">3690 kr</b></span></div>\n            <p class=\"ti-desc\">Mascarpone, ofnbakaðar kartöflur, trufflu aioli, klettasalat og parmesan</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Perur</span><span class=\"ti-pr\"><b class=\"ti-new\">3690 kr</b></span></div>\n            <p class=\"ti-desc\">Mascarpone, perur, ferskur mozzarella, gráðaostur, karamellaðar valhnetur og klettasalat</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 21px !important;\">Mortadella &amp; pistasíur</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, ferskur mozzarella, mortadella, burrata stracciatella, pistasíu pestó og muldar pistasíur.</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Hálfmáni</span><span class=\"ti-pr\"><b class=\"ti-new\">3690 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, mozzarella, sveppir, silkiskorin skinka eða pepperóní</p></div>\n        ",
      "DIV1>DIV3>DIV5": "\n          <h2><span>Aðalréttir</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Kjúklinga Milanese</span><span class=\"ti-pr\"><b class=\"ti-new\">5990 kr</b></span></div>\n            <p class=\"ti-desc\">Djúpsteikt kjúklingabringa í raspi borin fram með smælki kartöflum, gremolata, klettasalati og parmesan.</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Ráðagerðis lasagna</span><span class=\"ti-pr\"><b class=\"ti-new\">3990 kr</b></span></div>\n            <p class=\"ti-desc\">Þrjú lög af bolognese kjötsósu, bechamel sósu, mozzarella og pasta toppað með parmesan og bakað í eldofninum okkar. Borið fram með eldbökuðu og stökku hvítlauksbrauði.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Ráðagerðis Bacalao</span><span class=\"ti-pr\"><b class=\"ti-new\">4590 kr</b></span></div>\n            <p class=\"ti-desc\">Saltfiskur í heimagerðri marinarasósu með blönduðum ólífum, hálfþurrkuðum tómötum, gremolata og nípu-\u0003flögum. Borið fram með eldbökuðu brauði.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Mascarpone kjötbollur</span><span class=\"ti-pr\"><b class=\"ti-new\">4590 kr</b></span></div>\n            <p class=\"ti-desc\">Eldbakaðar kjötbollur með mascarpone sveppasósu, \u0003steiktum sveppum, kartöflum, rauðlauk, gremolata, parmesan og spínati. Borið fram með eldbökuðu brauði.</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Trufflu <br>Pasta (V)</span><span class=\"ti-pr\"><b class=\"ti-new\">3990 kr</b></span></div>\n            <p class=\"ti-desc\">Pasta í hvítri trufflusósu með steiktum kastaníu sveppum, spínati, karmelluseruðum valhnetum, toppað með vegan parmesan.</p></div>\n          \n          \n          \n        ",
      "DIV1>DIV3>DIV6": "\n          <h2 class=\"\"><span class=\"\">Salat</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Sesar hússins</span><span class=\"ti-pr\"><b class=\"ti-new\">3890 kr</b></span></div>\n            <p class=\"ti-desc\" style=\"font-weight: 400 !important;\">Romain salat, parmesan, ferskir og hálfþurrkaðir tómatar, stökk parmaskinka, stökkt brauð og kryddjurtadressing. <br><br>Veldu: <b class=\"\">kjúkling, rækjur eða grillaðan kúrbít. </b><br><br>Bættu við feta osti fyrir 500 kr. <br><br><b>Hægt að fá vegan</b></p></div>\n        ",
      "DIV1>DIV3>DIV7": "\n          <h2><span>Súpa</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Rjómalöguð Tómat-Basil Súpa</span><span class=\"ti-pr\"><b class=\"ti-new\">2490 kr</b></span></div>\n            <p class=\"ti-desc\">Heimalöguð heit súpa úr hágæða ítölskum tómötum borin fram með stökku eldbökuðu hvítlauksbrauði.</p></div>\n        ",
      "DIV1>DIV3>DIV8": "\n          <h2><span class=\"\">Eftirréttir</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Tiramisu</span><span class=\"ti-pr\"><b class=\"ti-new\">2.190 kr</b></span></div>\n            <p class=\"ti-desc\">Klassískur ítalskur eftirréttur</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 21px !important;\">Limoncello kaka</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div>\n            <p class=\"ti-desc\">Sítrónukaka með möndluflögum, borin fram með rjóma</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Brennd basknesk ostakaka</span><span class=\"ti-pr\"><b class=\"ti-new\">2.290 kr</b></span></div>\n            <p class=\"ti-desc\">Borin fram með vanilluís</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Súkkulaði kaka</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div>\n            <p class=\"ti-desc\">Borin fram með vanilluís</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Affogato</span><span class=\"ti-pr\"><b class=\"ti-new\">1.690 kr</b></span></div>\n            <p class=\"ti-desc\">Vanilluískúla og skot af espresso. Limoncello í stað espresso fyrir 600 kr. aukalega</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Vanilluís</span><span class=\"ti-pr\"><b class=\"ti-new\">1.190 kr</b></span></div>\n            <p class=\"ti-desc\">Vanilluís með súkkulaði- eða karamellusósu</p></div>\n          \n          \n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\"><br></span><span class=\"ti-pr\"><b class=\"ti-new\"></b></span></div>\n            <p class=\"ti-desc\" style=\"font-size: 17px !important;\"><span style=\"font-family: Windsord, serif; font-size: 15px !important; letter-spacing: 0.864px; text-transform: uppercase;\" class=\"\">Aðeins í boði á virkum til kl 17:00</span></p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 23px !important;\">Vaffla m/ rjóma og sultu</span><span class=\"ti-pr\"><b class=\"ti-new\">1.590 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\" style=\"font-size: 21px !important;\">Vaffla m/ vanilluís og flórsykri</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div></div>\n        ",
      "DIV2>DIV0": "<img src=\"assets/insta/insta-01.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-02.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-03.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-04.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-05.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-06.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-07.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-08.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-09.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-01.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-02.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-03.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-04.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-05.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-06.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-07.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-08.jpg\" alt=\"\" loading=\"lazy\"><img src=\"assets/insta/insta-09.jpg\" alt=\"\" loading=\"lazy\">"
    },
    "eftirrettir.html": {
      "DIV1>DIV2>DIV0>DIV0": "\n          <h2 class=\"\"><span>Eftirréttir</span></h2>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Tiramisu</span><span class=\"ti-pr\"><b class=\"ti-new\">2.190 kr</b></span></div>\n            <p class=\"ti-desc\">Klassískur ítalskur eftirréttur</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Limoncello kaka</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div>\n            <p class=\"ti-desc\">Sítrónukaka með möndluflögum, borin fram með rjóma</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Brennd basknesk ostakaka</span><span class=\"ti-pr\"><b class=\"ti-new\">2.290 kr</b></span></div>\n            <p class=\"ti-desc\">Borin fram með vanilluís</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Súkkulaði kaka</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div>\n            <p class=\"ti-desc\">Borin fram með vanilluís</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Affogato</span><span class=\"ti-pr\"><b class=\"ti-new\">1.690 kr</b></span></div>\n            <p class=\"ti-desc\">Vanilluískúla og skot af espresso. Limoncello í stað espresso fyrir 600 kr. aukalega</p></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Vanilluís</span><span class=\"ti-pr\"><b class=\"ti-new\">1.190 kr</b></span></div>\n            <p class=\"ti-desc\">Vanilluís með súkkulaði- eða karamellusósu</p></div>\n          \n          \n          \n        ",
      "DIV1>DIV2>DIV1>DIV0": "\n          <h2 class=\"\"><span>Vaffla</span></h2>\n          <p class=\"vnote\">Alla virka daga til kl. 17&nbsp;</p>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Með rjóma og sultu</span><span class=\"ti-pr\"><b class=\"ti-new\">1.590 kr</b></span></div></div>\n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Með vanilluís og flórsykri</span><span class=\"ti-pr\"><b class=\"ti-new\">1.990 kr</b></span></div></div>\n        "
    },
    "brons.html": {
      "DIV1>DIV2>DIV0>DIV0": "\n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Brönsplatti Ráðagerðis</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Tvö spæld egg, beikon, avocado, ferskt tómat salsa, salat og steiktar smælki kartöflur m/ jógúrtsósu. Borið fram með eldbökuðu brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Vegan Brunchplatti (V)</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Kórónubaunir, Grillaðir tómatar, grillaður kúrbítur, avocado, salat m/ fersku tómat salsa og balsamik gljáa, Steiktar smælki kartöflur. Borið fram með eldbökuðu brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Shakshuka</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Tvö spæld egg í þykkri sósu úr papriku, tómötum, lauk og hvítlauk, toppað með feta osti og steinselju borið fram með eldbökuðu brauði</p></div>\n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Tyrknesk Egg</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Tvö hleypt egg borin fram á krydduðu grísku jógúrti m/ dilli, sítrónu, hvítlauki og myntu. Toppað með Nduja-smjöri og borið fram með eldbökuðu brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Avókadó Bruschetta</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Avókadó, Tómat salsa og hleypt egg, toppað með pistasíupestói</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Laxa Bruschetta</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Pistasíupestó, salat, reyktur lax, hleypt egg með dill jógúrt sósu</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Beikon Bruschetta</span><span class=\"ti-pr\"><b class=\"ti-new\">3590 kr</b></span></div>\n            <p class=\"ti-desc\">Dill jógúrtsósa, salat, bacon, spælt egg, toppað m/ Nduja smjöri</p></div>\n          \n          <div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Brunch Pizza</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Mascarpone, ostur, beikon, kartöflur, gremolata, parmesan, eggjarauður og spælt egg</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Avókadó Pizza (V)</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Tómatar, hálfþurrkaðir tómatar, vegan ostur, avókadó, klettasalat, ferskt tómatsalsa og stökkar grænmetisflögur</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Laxa Pizza</span><span class=\"ti-pr\"><b class=\"ti-new\">3890 kr</b></span></div>\n            <p class=\"ti-desc\">Mascarpone, ostur, spínat, reyktur lax, burrata stracciatella, kirsuberjatómatar og vorlaukur</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Djúpsteiktur Burrata</span><span class=\"ti-pr\"><b class=\"ti-new\">3790 kr</b></span></div>\n            <p class=\"ti-desc\">Borið fram m/ rjómalagaðri marinara sósu, pestó dressingu og eldbökuðu brauði</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Beikon Vaffla</span><span class=\"ti-pr\"><b class=\"ti-new\">2790 kr</b></span></div>\n            <p class=\"ti-desc\">Vaffla, beikon, spæld egg og síróp</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Hindberja Vaffla</span><span class=\"ti-pr\"><b class=\"ti-new\">2490 kr</b></span></div>\n            <p class=\"ti-desc\">Vaffla, heimalöguð hindberja– og mangó sulta, þeyttur rjómi</p></div><div class=\"ti\" style=\"position: relative;\"><div class=\"ti-head\"><span class=\"ti-nm\">Ráðagerðis \"French Toast\"</span><span class=\"ti-pr\"><b class=\"ti-new\">3390 kr</b></span></div>\n            <p class=\"ti-desc\">Eldbakað brauð toppað með blönduðum berjum, hindberja-mangósultu, þeyttum mascarpone rjóma og flórsykri</p></div>\n          \n          \n          \n          \n          \n          \n          \n          \n          \n        "
    },
